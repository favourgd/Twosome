<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Twosome Quiz Game</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Lato:wght@400;700&display=swap">

<style>
  /* Layout: full-screen single-question game with animated score and progress */
  :root {
    --bg: #0F172A;
    --card: #1E293B;
    --card2: #263248;
    --fg: #F1F5F9;
    --subtle: #94A3B8;
    --accent: #38BDF8;
    --accent2: #0EA5E9;
    --correct: #22C55E;
    --wrong: #EF4444;
    --warn: #F59E0B;
    --border: #334155;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      --bg: #F0F9FF;
      --card: #FFFFFF;
      --card2: #E0F2FE;
      --fg: #0F172A;
      --subtle: #64748B;
      --accent: #0284C7;
      --accent2: #0369A1;
      --correct: #16A34A;
      --wrong: #DC2626;
      --warn: #D97706;
      --border: #BAE6FD;
      color-scheme: light;
    }
  }
  :root[data-theme="light"] {
    --bg: #F0F9FF;
    --card: #FFFFFF;
    --card2: #E0F2FE;
    --fg: #0F172A;
    --subtle: #64748B;
    --accent: #0284C7;
    --accent2: #0369A1;
    --correct: #16A34A;
    --wrong: #DC2626;
    --warn: #D97706;
    --border: #BAE6FD;
    color-scheme: light;
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 1rem;
    min-height: 100%;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    padding-block: 0;
  }

  .screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding-block: 32px;
  }

  /* HEADER BRAND */
  .brand {
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  /* START SCREEN */
  #start-screen { text-align: center; gap: 0; }
  .start-icon {
    font-size: 4rem;
    margin-bottom: 12px;
    display: block;
    animation: bounce 1.6s ease-in-out infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) { .start-icon { animation: none; } }

  #start-screen h1 {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 900;
    margin: 0 0 10px;
    text-wrap: balance;
    line-height: 1.1;
  }
  #start-screen h1 span { color: var(--accent); }
  #start-screen p {
    color: var(--subtle);
    max-width: 380px;
    margin: 0 auto 32px;
    line-height: 1.6;
    text-wrap: balance;
  }
  .meta-pills {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .pill {
    background: var(--card2);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 5px 14px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--subtle);
    letter-spacing: 0.04em;
  }
  .pill .val { color: var(--accent); }

  /* BUTTONS */
  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 16px 40px;
    font-family: 'Nunito', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    cursor: pointer;
    transition: transform 0.1s, opacity 0.1s;
    letter-spacing: 0.02em;
  }
  .btn-primary:hover { opacity: 0.88; transform: translateY(-2px); }
  .btn-primary:active { transform: translateY(0); }

  .btn-secondary {
    background: var(--card);
    color: var(--fg);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 13px 28px;
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .btn-secondary:hover { border-color: var(--accent); }

  /* QUIZ SCREEN */
  #quiz-screen { width: 100%; max-width: 600px; gap: 0; }

  .progress-bar-wrap {
    width: 100%;
    height: 6px;
    background: var(--card2);
    border-radius: 100px;
    margin-bottom: 24px;
    overflow: hidden;
  }
  .progress-bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 100px;
    transition: width 0.4s ease;
  }

  .quiz-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    width: 100%;
  }
  .q-counter {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--subtle);
  }
  .score-badge {
    background: var(--card2);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 4px 14px;
    font-family: 'Nunito', sans-serif;
    font-size: 0.9rem;
    font-weight: 900;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .question-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px 24px 24px;
    margin-bottom: 20px;
    width: 100%;
  }
  .question-card p {
    font-family: 'Nunito', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.45;
    margin: 0;
    text-wrap: balance;
  }

  .options {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    margin-bottom: 16px;
  }
  .opt-btn {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 14px 18px;
    font-family: 'Lato', sans-serif;
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--fg);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .opt-btn:hover:not(:disabled) { border-color: var(--accent); background: var(--card2); transform: translateX(3px); }
  .opt-btn .opt-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--card2);
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    font-size: 0.85rem;
    flex-shrink: 0;
    color: var(--subtle);
    transition: background 0.15s, color 0.15s;
  }
  .opt-btn.correct { border-color: var(--correct); background: color-mix(in srgb, var(--correct) 12%, var(--card)); }
  .opt-btn.correct .opt-letter { background: var(--correct); color: #fff; }
  .opt-btn.wrong { border-color: var(--wrong); background: color-mix(in srgb, var(--wrong) 12%, var(--card)); }
  .opt-btn.wrong .opt-letter { background: var(--wrong); color: #fff; }
  .opt-btn:disabled { cursor: default; transform: none; }

  .feedback-row {
    min-height: 28px;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--subtle);
    text-align: center;
  }
  .feedback-row.good { color: var(--correct); }
  .feedback-row.bad  { color: var(--wrong); }

  .next-btn-wrap { width: 100%; display: flex; justify-content: flex-end; }

  /* RESULTS SCREEN */
  #result-screen { text-align: center; gap: 0; }
  .trophy { font-size: 3.5rem; margin-bottom: 12px; display: block; }
  #result-screen h2 {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(1.6rem, 6vw, 2.4rem);
    font-weight: 900;
    margin: 0 0 8px;
    text-wrap: balance;
  }
  .score-display {
    font-family: 'Nunito', sans-serif;
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--accent);
    line-height: 1;
    margin: 16px 0 4px;
    font-variant-numeric: tabular-nums;
  }
  .score-label { color: var(--subtle); font-size: 0.9rem; margin-bottom: 28px; }

  .result-msg {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 20px;
    max-width: 420px;
    margin: 0 auto 28px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--subtle);
  }

  .result-btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-bottom: 36px; }

  .opinion-cta {
    background: var(--card2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    max-width: 420px;
    width: 100%;
    text-align: center;
  }
  .opinion-cta p {
    margin: 0 0 12px;
    font-size: 0.92rem;
    color: var(--subtle);
  }
  .opinion-cta a {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    border-radius: 10px;
    padding: 11px 24px;
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    font-size: 0.95rem;
    transition: opacity 0.15s;
  }
  .opinion-cta a:hover { opacity: 0.85; }

  .footer-note {
    margin-top: 32px;
    color: var(--subtle);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-align: center;
  }
  .footer-note strong { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<!-- START SCREEN -->
<div class="screen" id="start-screen">
  <div class="brand">Twosome</div>
  <span class="start-icon">🧠</span>
  <h1>Ready to<br><span>Test Your Mind?</span></h1>
  <p>Answer questions about lessons, life skills, and what it means to keep growing. See how well you do!</p>
  <div class="meta-pills">
    <div class="pill"><span class="val">8</span> Questions</div>
    <div class="pill"><span class="val">10 pts</span> Each</div>
    <div class="pill">🌱 Learning</div>
  </div>
  <button class="btn-primary" onclick="startQuiz()">Start Quiz</button>
</div>

<!-- QUIZ SCREEN -->
<div class="screen" id="quiz-screen" hidden>
  <div class="brand">Twosome Quiz</div>
  <div class="progress-bar-wrap" style="width:100%;max-width:600px;">
    <div class="progress-bar-fill" id="progress-fill" style="width:0%"></div>
  </div>
  <div class="quiz-top" style="max-width:600px;">
    <div class="q-counter" id="q-counter">Question 1 of 8</div>
    <div class="score-badge">⭐ <span id="live-score">0</span> pts</div>
  </div>
  <div class="question-card" id="question-card">
    <p id="question-text"></p>
  </div>
  <div class="options" id="options-wrap"></div>
  <div class="feedback-row" id="feedback-row"></div>
  <div class="next-btn-wrap">
    <button class="btn-primary" id="next-btn" onclick="nextQuestion()" hidden>Next →</button>
  </div>
</div>

<!-- RESULT SCREEN -->
<div class="screen" id="result-screen" hidden>
  <div class="brand">Twosome</div>
  <span class="trophy" id="trophy-icon">🏆</span>
  <h2 id="result-title">Well Done!</h2>
  <div class="score-display" id="final-score">0</div>
  <div class="score-label" id="score-label">out of 80 points</div>
  <div class="result-msg" id="result-msg"></div>
  <div class="result-btns">
    <button class="btn-primary" onclick="restartQuiz()">Play Again</button>
    <button class="btn-secondary" onclick="reviewAnswers()">Review Answers</button>
  </div>
  <div class="opinion-cta">
    <p>Enjoyed the quiz? Share your thoughts with us!</p>
    <a href="https://docs.google.com/forms/d/e/1FAIpQLSd9uU-wem4XiVRAUhLL3imt8eOiNkkjrp__ZlAAJ1C5NN5Vtw/viewform?usp=publish-editor" target="_blank">Share My Opinion 🌱</a>
  </div>
  <div class="footer-note">Powered by <strong>GD</strong> · Twosome · 2026</div>
</div>

<script>
const QUESTIONS = [
  {
    q: "What is the most important reason to keep learning every day?",
    options: ["To show off to others", "To grow and improve yourself", "To finish school faster", "To earn more money quickly"],
    correct: 1,
    explain: "Learning every day helps you grow as a person — it builds your skills, confidence, and opens new doors."
  },
  {
    q: "A seed grows even in dry ground. What does this teach us?",
    options: ["That seeds need no water at all", "That only some things can survive hard times", "That the will to grow can be stronger than difficult conditions", "That dry ground is always better for plants"],
    correct: 2,
    explain: "The seed story teaches us that a strong will to grow can push through even the hardest conditions."
  },
  {
    q: "What does true failure really mean?",
    options: ["Getting an answer wrong in class", "Trying something difficult", "Staying down when you still have strength to rise", "Not knowing the right answer"],
    correct: 2,
    explain: "Failure is not falling — it's choosing to stay down. As long as you get up and try again, you have not truly failed."
  },
  {
    q: "Which habit helps the most when you are struggling to learn something?",
    options: ["Giving up and trying something easier", "Asking for help and trying again", "Waiting for someone else to explain it", "Pretending you already understand"],
    correct: 1,
    explain: "Asking for help and trying again is the best habit. Nobody learns alone — and persistence is what leads to understanding."
  },
  {
    q: "Amara returned to school after seeing the seed. What was her biggest act of courage?",
    options: ["She watered the seed every day", "She told the whole village what she saw", "She sat at her old desk even though it felt too small", "She planted more seeds in the garden"],
    correct: 2,
    explain: "Amara's courage was going back even when she felt out of place. Starting again, however small it feels, takes real bravery."
  },
  {
    q: "Why is it important to share what you learn with others?",
    options: ["So others know you are smarter", "So learning can multiply and help more people grow", "So teachers give you better marks", "So you can finish your work faster"],
    correct: 1,
    explain: "Knowledge shared is knowledge multiplied. When you teach others what you know, learning grows in the whole community."
  },
  {
    q: "What does a motivational story help a reader do?",
    options: ["Memorise facts for an exam", "Feel inspired and see new possibilities in their own life", "Learn new language grammar", "Understand science better"],
    correct: 1,
    explain: "A good motivational story holds a mirror up to your own life and shows you what is possible — it sparks hope and action."
  },
  {
    q: "Which of these best describes the right attitude toward a difficult challenge?",
    options: ["Avoid it until you feel fully ready", "Wait for someone else to solve it first", "Face it step by step, learning as you go", "Complain about how hard it is"],
    correct: 2,
    explain: "Facing a challenge step by step — without waiting to feel perfect — is how progress actually happens."
  }
];

let current = 0;
let score = 0;
let answered = [];

function startQuiz() {
  current = 0; score = 0; answered = [];
  document.getElementById('start-screen').hidden = true;
  document.getElementById('result-screen').hidden = true;
  document.getElementById('quiz-screen').hidden = false;
  showQuestion();
}

function showQuestion() {
  const q = QUESTIONS[current];
  const total = QUESTIONS.length;

  document.getElementById('progress-fill').style.width = ((current / total) * 100) + '%';
  document.getElementById('q-counter').textContent = 'Question ' + (current + 1) + ' of ' + total;
  document.getElementById('live-score').textContent = score;
  document.getElementById('question-text').textContent = q.q;
  document.getElementById('feedback-row').textContent = '';
  document.getElementById('feedback-row').className = 'feedback-row';
  document.getElementById('next-btn').hidden = true;

  const letters = ['A', 'B', 'C', 'D'];
  const wrap = document.getElementById('options-wrap');
  wrap.innerHTML = '';
  q.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'opt-btn';
    btn.innerHTML = '<span class="opt-letter">' + letters[i] + '</span>' + opt;
    btn.onclick = () => selectAnswer(i, btn);
    wrap.appendChild(btn);
  });
}

function selectAnswer(index, btn) {
  const q = QUESTIONS[current];
  const buttons = document.querySelectorAll('.opt-btn');
  buttons.forEach(b => b.disabled = true);

  const fb = document.getElementById('feedback-row');
  if (index === q.correct) {
    btn.classList.add('correct');
    score += 10;
    document.getElementById('live-score').textContent = score;
    fb.textContent = '✓ Correct! ' + q.explain;
    fb.className = 'feedback-row good';
    answered.push({ q: q.q, chosen: q.options[index], correct: q.options[q.correct], right: true });
  } else {
    btn.classList.add('wrong');
    buttons[q.correct].classList.add('correct');
    fb.textContent = '✗ The right answer: ' + q.options[q.correct] + '. ' + q.explain;
    fb.className = 'feedback-row bad';
    answered.push({ q: q.q, chosen: q.options[index], correct: q.options[q.correct], right: false });
  }
  document.getElementById('next-btn').hidden = false;
}

function nextQuestion() {
  current++;
  if (current < QUESTIONS.length) {
    showQuestion();
  } else {
    showResults();
  }
}

function showResults() {
  document.getElementById('quiz-screen').hidden = true;
  document.getElementById('result-screen').hidden = false;
  document.getElementById('progress-fill').style.width = '100%';

  const pct = score / (QUESTIONS.length * 10);
  document.getElementById('final-score').textContent = score;
  document.getElementById('score-label').textContent = 'out of ' + (QUESTIONS.length * 10) + ' points';

  let trophy, title, msg;
  if (pct === 1) {
    trophy = '🏆'; title = 'Perfect Score!';
    msg = 'Outstanding! You answered every question correctly. You are a true learner — keep inspiring others around you!';
  } else if (pct >= 0.75) {
    trophy = '🌟'; title = 'Excellent Work!';
    msg = 'You did really well! A few questions slipped by but your understanding is strong. Review the ones you missed and you will be unstoppable.';
  } else if (pct >= 0.5) {
    trophy = '👍'; title = 'Good Effort!';
    msg = 'You are on the right track. Half the battle is showing up and trying. Read back through the story and quiz yourself again — you will do even better!';
  } else {
    trophy = '🌱'; title = 'Keep Growing!';
    msg = 'Every expert was once a beginner. Do not give up — go back, read the lesson story, and try again. Each attempt makes you stronger.';
  }
  document.getElementById('trophy-icon').textContent = trophy;
  document.getElementById('result-title').textContent = title;
  document.getElementById('result-msg').textContent = msg;
}

function restartQuiz() {
  startQuiz();
}

function reviewAnswers() {
  const wrap = document.getElementById('options-wrap');
  // scroll to result and show review inline
  const card = document.getElementById('question-card');
  document.getElementById('quiz-screen').hidden = false;
  document.getElementById('result-screen').hidden = true;

  let html = '<div style="width:100%;max-width:600px;">';
  html += '<div style="font-family:\'Nunito\',sans-serif;font-weight:900;font-size:1.1rem;margin-bottom:20px;color:var(--accent);">Review — Your Answers</div>';
  answered.forEach((a, i) => {
    const color = a.right ? 'var(--correct)' : 'var(--wrong)';
    const icon = a.right ? '✓' : '✗';
    html += '<div style="background:var(--card);border:1.5px solid ' + color + ';border-radius:12px;padding:16px;margin-bottom:12px;">';
    html += '<div style="font-weight:700;margin-bottom:8px;font-size:0.92rem;">' + (i+1) + '. ' + a.q + '</div>';
    html += '<div style="font-size:0.85rem;color:' + color + ';font-weight:700;">' + icon + ' Your answer: ' + a.chosen + '</div>';
    if (!a.right) html += '<div style="font-size:0.85rem;color:var(--correct);font-weight:700;margin-top:4px;">✓ Correct: ' + a.correct + '</div>';
    html += '</div>';
  });
  html += '<div style="display:flex;gap:12px;margin-top:20px;flex-wrap:wrap;">';
  html += '<button class="btn-primary" onclick="startQuiz()">Play Again</button>';
  html += '<button class="btn-secondary" onclick="showResults()">Back to Results</button>';
  html += '</div></div>';

  document.getElementById('question-card').innerHTML = html;
  document.getElementById('options-wrap').innerHTML = '';
  document.getElementById('feedback-row').textContent = '';
  document.getElementById('next-btn').hidden = true;
  document.getElementById('quiz-top') && (document.getElementById('quiz-top').hidden = true);
  document.getElementById('progress-fill').style.width = '100%';
  document.getElementById('q-counter').textContent = 'Review';
  document.getElementById('live-score').textContent = score;
}

function showResults() {
  document.getElementById('quiz-screen').hidden = true;
  document.getElementById('result-screen').hidden = false;
}
</script>

</body></html>
